{
  "name": "d365-fscm-cost-estimator",
  "version": "0.1.0",
  "private": true,
  "description": "Budgetary cost estimator for Dynamics 365 F&SCM implementation projects: environments, storage, licensing add-ons — with an explanation for every dollar.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
